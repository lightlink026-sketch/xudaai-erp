APP_NAME=Xudaai Product Library
DATA_DIR=./data
TEMPLATES_DIR=./data/templates
LIBRARY_DIR=./library
LIBRARY_HOST_PATH=./library
APP_DATA_HOST_PATH=./data
MODEL_CACHE_HOST_PATH=./model-cache
# Leave DATABASE_URL unset for local SQLite. Team/NAS example:
# DATABASE_URL=postgresql+psycopg://xudaai:change-this-password@postgres:5432/xudaai
POSTGRES_DB=xudaai
POSTGRES_USER=xudaai
POSTGRES_PASSWORD=change-this-before-team-use
HF_HOME=./model-cache/huggingface
TORCH_HOME=./model-cache/torch
APP_PORT=8000
APP_USER=admin
APP_PASSWORD=
MAX_UPLOAD_MB=25
SYNC_INTERVAL_SECONDS=300
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
IMAGE_SEARCH_MODE=clip
ENABLE_CLIP=1
ENABLE_MEDIA_AI=0
WHISPER_MODEL=small
OCR_LANG=chi_sim+eng
